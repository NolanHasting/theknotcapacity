{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/sms/config",
        "function": {
          "functionId": "smsSubscribe",
          "region": "us-east1"
        }
      },
      {
        "source": "/api/sms/inbound",
        "function": {
          "functionId": "smsInbound",
          "region": "us-east1"
        }
      },
      {
        "source": "/api/planner",
        "function": {
          "functionId": "plannerApi",
          "region": "us-east1"
        }
      },
      {
        "source": "/api/history",
        "function": {
          "functionId": "getHistory",
          "region": "us-east1"
        }
      },
      {
        "source": "/api/status",
        "function": {
          "functionId": "getOccupancy",
          "region": "us-east1"
        }
      }
    ],
    "headers": [
      {
        "source": "/api/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|png)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/firebase-messaging-sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          },
          {
            "key": "Service-Worker-Allowed",
            "value": "/"
          }
        ]
      }
    ]
  }
}
